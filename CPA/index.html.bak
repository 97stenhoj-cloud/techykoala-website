<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="CPA - Content Posting Automation for TikTok. Schedule and automatically post content to TikTok with ease. By TechyKoala.">
    <meta name="keywords" content="TikTok automation, content posting, schedule TikTok posts, auto post TikTok, CPA, TechyKoala">
    <meta name="author" content="TechyKoala">

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="CPA - Content Posting Automation for TikTok">
    <meta property="og:description" content="Schedule and automatically post content to TikTok. Simplify your content workflow with CPA by TechyKoala.">
    <meta property="og:image" content="https://tpjsebutbieghpmvpktv.supabase.co/storage/v1/object/public/AppIcon/techykoalaIcon.png">
    <meta property="og:url" content="https://www.techykoala.com/CPA">
    <meta property="og:type" content="website">

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="CPA - Content Posting Automation for TikTok">
    <meta name="twitter:description" content="Schedule and automatically post content to TikTok. Simplify your content workflow.">
    <meta name="twitter:image" content="https://tpjsebutbieghpmvpktv.supabase.co/storage/v1/object/public/AppIcon/techykoalaIcon.png">

    <title>CPA - Content Posting Automation for TikTok | TechyKoala</title>

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.techykoala.com/CPA/">

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="https://tpjsebutbieghpmvpktv.supabase.co/storage/v1/object/public/AppIcon/AppIcon.png">
    <link rel="apple-touch-icon" href="https://tpjsebutbieghpmvpktv.supabase.co/storage/v1/object/public/AppIcon/AppIcon.png">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Styles -->
    <link rel="stylesheet" href="/Connect/styles.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="site-header">
        <div class="container">
            <div class="header-container">
                <a href="/" class="logo">
                    <img src="https://tpjsebutbieghpmvpktv.supabase.co/storage/v1/object/public/AppIcon/techykoalaIcon.png" alt="TechyKoala Logo">
                    <span>TechyKoala</span>
                </a>
                <button class="mobile-menu-toggle" onclick="toggleMobileMenu()" aria-label="Toggle menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <div class="main-nav" id="mobileNav">
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href="/Connect/">Connect App</a></li>
                        <li><a href="/CPA/">CPA</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <main class="site-main">

        <!-- Hero Section -->
        <section class="hero" style="min-height: 90vh;">
            <div class="container">
                <div class="hero-content">
                    <div style="width: 120px; height: 120px; border-radius: 28px; margin: 0 auto 30px; box-shadow: 0 12px 40px rgba(0,0,0,0.15); background: linear-gradient(135deg, #00f2ea, #ff0050); display: flex; align-items: center; justify-content: center;">
                        <svg width="60" height="60" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                        </svg>
                    </div>
                    <h1>CPA</h1>
                    <p style="font-size: 1.5rem; max-width: 700px; margin: 0 auto 10px; font-weight: 600; color: var(--text-dark);">
                        Content Posting Automation
                    </p>
                    <p style="font-size: 1.3rem; max-width: 700px; margin: 0 auto 40px;">
                        Schedule and automatically post your content to TikTok. Simplify your workflow, stay consistent, and grow your audience.
                    </p>
                    <div class="hero-buttons">
                        <a href="#features" class="btn btn-primary">Explore Features</a>
                        <a href="#how-it-works" class="btn btn-secondary">How It Works</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Features Section -->
        <section class="section" id="features">
            <div class="container">
                <h2 style="text-align: center;">Why CPA?</h2>
                <p style="text-align: center; font-size: 1.2rem; max-width: 600px; margin: 0 auto;">
                    Everything you need to automate your TikTok content posting workflow.
                </p>
                <div class="grid grid-3">
                    <div class="card" style="text-align: center;">
                        <div style="font-size: 3rem; margin-bottom: 20px;">&#128197;</div>
                        <h3>Scheduled Posting</h3>
                        <p>Plan your content calendar and let CPA post automatically at the perfect time for your audience.</p>
                    </div>
                    <div class="card" style="text-align: center;">
                        <div style="font-size: 3rem; margin-bottom: 20px;">&#9889;</div>
                        <h3>Fully Automated</h3>
                        <p>No need to open TikTok. Once authorized, your content is posted automatically through the official API.</p>
                    </div>
                    <div class="card" style="text-align: center;">
                        <div style="font-size: 3rem; margin-bottom: 20px;">&#128274;</div>
                        <h3>Secure & Private</h3>
                        <p>Your credentials and content are handled securely. We never store your TikTok password — only OAuth tokens.</p>
                    </div>
                    <div class="card" style="text-align: center;">
                        <div style="font-size: 3rem; margin-bottom: 20px;">&#128203;</div>
                        <h3>Content Queue</h3>
                        <p>Upload multiple videos and manage them in a queue. CPA handles the rest, posting them on schedule.</p>
                    </div>
                    <div class="card" style="text-align: center;">
                        <div style="font-size: 3rem; margin-bottom: 20px;">&#128640;</div>
                        <h3>Stay Consistent</h3>
                        <p>Consistency is key to growth. CPA ensures your content goes live even when you're busy.</p>
                    </div>
                    <div class="card" style="text-align: center;">
                        <div style="font-size: 3rem; margin-bottom: 20px;">&#128736;&#65039;</div>
                        <h3>Official TikTok API</h3>
                        <p>Built on TikTok's official Content Posting API. Fully compliant, no hacks or workarounds.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- How It Works Section -->
        <section class="section" id="how-it-works" style="background: rgba(255, 255, 255, 0.5); padding: 80px 0;">
            <div class="container">
                <h2 style="text-align: center;">How It Works</h2>
                <p style="text-align: center; font-size: 1.2rem; max-width: 600px; margin: 0 auto;">
                    Get started in three simple steps.
                </p>
                <div class="grid grid-3" style="margin-top: 48px;">
                    <div class="card" style="text-align: center; position: relative;">
                        <div style="width: 50px; height: 50px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-pink), var(--accent-peach)); color: white; font-size: 1.5rem; font-weight: 800; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">1</div>
                        <h3>Connect Your Account</h3>
                        <p>Authorize CPA to access your TikTok account through TikTok's secure OAuth login. Takes less than a minute.</p>
                    </div>
                    <div class="card" style="text-align: center;">
                        <div style="width: 50px; height: 50px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-pink), var(--accent-peach)); color: white; font-size: 1.5rem; font-weight: 800; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">2</div>
                        <h3>Upload Your Content</h3>
                        <p>Upload your videos, add captions and hashtags, and set your preferred posting schedule.</p>
                    </div>
                    <div class="card" style="text-align: center;">
                        <div style="width: 50px; height: 50px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-pink), var(--accent-peach)); color: white; font-size: 1.5rem; font-weight: 800; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">3</div>
                        <h3>Sit Back & Grow</h3>
                        <p>CPA automatically posts your content at the scheduled times. Focus on creating, we handle the posting.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA / Contact Section -->
        <section class="section cta-section" id="contact">
            <div class="container">
                <div class="card download-card">
                    <h2>Ready to Automate?</h2>
                    <p>Get in touch to start using CPA for your TikTok content strategy.</p>
                    <a href="mailto:support@techykoala.com" class="btn btn-primary">Contact Us</a>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>TechyKoala</h3>
                    <p>Creating meaningful digital experiences</p>
                </div>
                <div class="footer-section">
                    <h4>CPA</h4>
                    <ul>
                        <li><a href="/CPA/">Overview</a></li>
                        <li><a href="/CPA/privacy-policy/">Privacy Policy</a></li>
                        <li><a href="/CPA/terms/">Terms & Conditions</a></li>
